# =============================================================================
# POSTRA - Production Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# Lines marked GENERATE: use the provided command to generate a value.
# Lines marked REQUIRED: must be filled before starting.
# =============================================================================

# === Domain & URLs (REQUIRED) ===
DOMAIN=postra.igk-digital.cloud
MAIN_URL=https://postra.igk-digital.cloud
FRONTEND_URL=https://postra.igk-digital.cloud
NEXT_PUBLIC_BACKEND_URL=https://postra.igk-digital.cloud/api
BACKEND_INTERNAL_URL=http://localhost:3000

# === Security (GENERATE) ===
# GENERATE: openssl rand -base64 48
JWT_SECRET=

# === App Database (GENERATE password) ===
POSTGRES_USER=postiz
# GENERATE: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=postiz

# === Temporal Database ===
TEMPORAL_POSTGRES_USER=temporal
# GENERATE: openssl rand -base64 32
TEMPORAL_POSTGRES_PASSWORD=

# === Application Settings ===
IS_GENERAL=true
DISABLE_REGISTRATION=false
NX_ADD_PLUGINS=false
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_SHOW_AGENTATION=true

# === Storage - Cloudflare R2 (REQUIRED) ===
STORAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKETNAME=
CLOUDFLARE_BUCKET_URL=
CLOUDFLARE_REGION=auto

# === Email (not configured - users auto-activated on registration) ===
# Uncomment and fill when you have a Resend account:
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=Postra

